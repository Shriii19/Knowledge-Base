NODE_ENV=development
PORT=3001
# Copy the connection string from your Neon dashboard. Keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Set this to the deployed frontend origin in production (no trailing slash).
CORS_ORIGIN=http://localhost:5173
# Set to 1 only when running behind exactly one trusted reverse proxy.
TRUST_PROXY=0
# Generate a random secret of at least 32 bytes; never commit it.
JWT_SECRET=
# Required only for the one-time setup-admin command. Remove after use.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
